// صفحة إنشاء الفيديو
app.get('/create', (req, res) => {
    res.send(`
    <!DOCTYPE html>
    <html dir="rtl" lang="ar">
    <head>
        <meta charset="UTF-8">
        <title>إنشاء فيديو جديد</title>
        <style>
            body { font-family: Arial; padding: 20px; background: #f0f2f5; }
            .container { max-width: 600px; margin: 0 auto; background: white; 
                       padding: 30px; border-radius: 15px; box-shadow: 0 5px 15px rgba(0,0,0,0.1); }
            h1 { text-align: center; color: #333; }
            .upload-area { border: 3px dashed #0088cc; border-radius: 10px; 
                         padding: 40px; text-align: center; margin: 20px 0; 
                         cursor: pointer; background: #f8f9fa; }
            .preview { max-width: 100%; margin: 20px 0; border-radius: 10px; display: none; }
            .styles { display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px; margin: 20px 0; }
            .style-btn { padding: 15px; border: 2px solid #ddd; border-radius: 8px; 
                        background: white; cursor: pointer; text-align: center; }
            .style-btn:hover { border-color: #0088cc; }
            .generate-btn { background: #0088cc; color: white; border: none; 
                          padding: 15px; border-radius: 8px; width: 100%; 
                          font-size: 18px; cursor: pointer; margin-top: 20px; }
            .back-btn { color: #0088cc; text-decoration: none; display: inline-block; margin-bottom: 20px; }
        </style>
    </head>
    <body>
        <div class="container">
            <a href="/" class="back-btn">← الرجوع</a>
            <h1>🎬 إنشاء فيديو جديد</h1>
            
            <div class="upload-area" id="uploadArea">
                <div style="font-size: 50px;">📷</div>
                <h3>اسحب وأفلت الصورة هنا</h3>
                <p>أو <span style="color: #0088cc; font-weight: bold;">انقر للاختيار</span></p>
                <input type="file" id="photoInput" accept="image/*" style="display: none;">
            </div>
            
            <img id="preview" class="preview" alt="معاينة">
            
            <div class="styles">
                <button class="style-btn" data-style="cinematic">🎬 سينمائي</button>
                <button class="style-btn" data-style="energetic">⚡ حماسي</button>
                <button class="style-btn" data-style="elegant">💎 أنيق</button>
                <button class="style-btn" data-style="modern">🏙️ عصري</button>
            </div>
            
            <textarea id="textInput" placeholder="اكتب نصاً للفيديو (اختياري)" 
                     style="width: 100%; padding: 15px; border: 2px solid #ddd; 
                            border-radius: 8px; margin: 10px 0; min-height: 100px;"></textarea>
            
            <button class="generate-btn" id="generateBtn">⚡ إنشاء الفيديو</button>
            
            <div id="result" style="display: none; text-align: center; margin-top: 30px;">
                <h2>✅ تم إنشاء الفيديو!</h2>
                <div id="videoResult"></div>
                <a id="downloadLink" class="generate-btn" style="text-decoration: none; margin-top: 10px;">
                    📥 تحميل الفيديو
                </a>
            </div>
        </div>
        
        <script>
            const uploadArea = document.getElementById('uploadArea');
            const photoInput = document.getElementById('photoInput');
            const preview = document.getElementById('preview');
            const generateBtn = document.getElementById('generateBtn');
            
            uploadArea.addEventListener('click', () => photoInput.click());
            
            photoInput.addEventListener('change', function(e) {
                const file = e.target.files[0];
                if (file) {
                    const reader = new FileReader();
                    reader.onload = function(e) {
                        preview.src = e.target.result;
                        preview.style.display = 'block';
                    };
                    reader.readAsDataURL(file);
                }
            });
            
            generateBtn.addEventListener('click', async () => {
                generateBtn.disabled = true;
                generateBtn.textContent = 'جاري الإنشاء...';
                
                setTimeout(() => {
                    const videoUrl = 'https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/BigBuckBunny.mp4';
                    
                    document.getElementById('result').style.display = 'block';
                    document.getElementById('videoResult').innerHTML = 
                        \`<video controls width="100%"><source src="\${videoUrl}" type="video/mp4"></video>\`;
                    document.getElementById('downloadLink').href = videoUrl;
                    
                    generateBtn.disabled = false;
                    generateBtn.textContent = '⚡ إنشاء الفيديو';
                }, 3000);
            });
        </script>
    </body>
    </html>
    `);
});

// API لإنشاء الفيديو
app.post('/api/generate', (req, res) => {
    setTimeout(() => {
        res.json({
            success: true,
            videoUrl: 'https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/BigBuckBunny.mp4',
            message: 'تم إنشاء الفيديو بنجاح!'
        });
    }, 2000);
});

// تشغيل الخادم
app.listen(PORT, () => {
    console.log(\`🚀 الخادم يعمل على: http://localhost:\${PORT}\`);
    console.log('🎬 موقع مولد الفيديوهات جاهز!');
});
